# Copiá este archivo a ".env" para correr Pandora en tu computadora.
# En Render, estas mismas variables se cargan desde el dashboard (Environment),
# nunca desde este archivo ni desde el repo.

# Clave para entrar como administrador (puede agregar/editar/borrar plataformas)
ADMIN_PASSPHRASE=cambiar-esta-clave-admin

# Clave para entrar como integrante (solo puede ver las plataformas)
MEMBER_PASSPHRASE=cambiar-esta-clave-integrante

# Clave de cifrado de 32 bytes en base64. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Cualquier texto largo y aleatorio, para firmar la sesión de login.
SESSION_SECRET=

# Dónde vive la base de datos SQLite.
DB_PATH=./data/pandora.db

PORT=3000
NODE_ENV=development
