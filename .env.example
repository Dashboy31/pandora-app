# Copiá este archivo a ".env" para correr Pandora en tu computadora.
# En Render, estas mismas variables se cargan desde el dashboard (Environment),
# nunca desde este archivo ni desde el repo.

# Cadena de conexión de Postgres (por ejemplo, de un proyecto gratis en Neon:
# https://neon.tech). Algo como:
#   postgresql://usuario:clave@host.neon.tech/basededatos?sslmode=require
DATABASE_URL=

# Clave de cifrado de 32 bytes en base64, para las contraseñas de cada
# plataforma guardadas en la base. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Cualquier texto largo y aleatorio, para firmar la sesión de login.
SESSION_SECRET=

PORT=3000
NODE_ENV=development
